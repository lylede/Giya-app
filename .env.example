APP_NAME=GIYA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── PostgreSQL ────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=giya_db
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Mail ──────────────────────────────────────────────────────
# 'log' keeps the app fully offline: reset links land in
# storage/logs/laravel.log instead of being sent over the network.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@giya.local"
MAIL_FROM_NAME="${APP_NAME}"

# ── Maya payments ─────────────────────────────────────────────
# These are Maya's PUBLISHED SANDBOX test keys (safe to share; no real money).
# For production, replace with your live keys and set
# MAYA_BASE_URL=https://pg.paymaya.com - never commit live keys.
MAYA_BASE_URL=https://pg-sandbox.paymaya.com
MAYA_PUBLIC_KEY=pk-Z0OSzLvIcOI2UIvDhdTGVVfRSSeiGStnceqwUE7n0Ah
MAYA_SECRET_KEY=sk-X8qolYjy62kIzEbr0QRK1h4b4KDVHaNcwMYk39jInSl
# Comma-separated. Leave unset to use Maya's documented addresses.
# MAYA_WEBHOOK_IPS=

# ── Proxies ───────────────────────────────────────────────────
# Set when running behind ngrok / Cloudflare / a load balancer so
# request()->ip() is the real client (needed for the webhook IP filter
# and for login throttling). "*" trusts any proxy - only safe when the
# app is not reachable except through that proxy.
# TRUSTED_PROXIES=*

# ── Giya AI (Groq) ────────────────────────────────────────────
# Free key: https://console.groq.com/keys - leave blank to run the
# assistant in offline mode (answers straight from the database).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
